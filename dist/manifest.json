{
  "manifest_version": 3,
  "name": "Facebook Page Photo Downloader | تحميل صور صفحات فيسبوك",
  "version": "1.0.0",
  "description": "أداة متقدمة لفحص وتحميل جميع صور وألبومات صفحات فيسبوك بدقة عالية ومباشرة إلى مجلد تختاره على جهازك.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Facebook Page Photo Downloader"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "dashboard.html"],
      "matches": ["https://*.facebook.com/*"]
    }
  ]
}
